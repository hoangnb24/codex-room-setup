#!/usr/bin/env zsh
set -euo pipefail

PASEO_REPO_DIR="${PASEO_REPO_DIR:-@@HOME@@/projects/supervisors/paseo}"
PASEO_HOME_DIR="${PASEO_HOME_DIR:-@@HOME@@/.paseo}"
PASEO_FORK_URL="${PASEO_FORK_URL:-git@github.com:hoangnb24/paseo.git}"
PASEO_UPSTREAM_URL="${PASEO_UPSTREAM_URL:-git@github.com:getpaseo/paseo.git}"
PASEO_BRANCH="${PASEO_BRANCH:-main}"
PASEO_VERIFIED_COMMIT="${PASEO_VERIFIED_COMMIT:-8511089eaeb06cddd049b629562926822020de5c}"
NPM_BIN="${PASEO_NPM_BIN:-npm}"
INSTALLED_APP="${PASEO_INSTALLED_APP:-/Applications/Paseo.app}"

if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
  print "Usage: paseo-local-update"
  print "Validate the immutable pin, build, sign, and install Paseo Desktop."
  exit 0
fi
[[ "$#" -eq 0 ]] || { print -u2 "Unknown argument: $1"; exit 2; }

[[ -d "$PASEO_REPO_DIR/.git" ]] || { print -u2 "Missing Paseo checkout: $PASEO_REPO_DIR"; exit 1; }
cd "$PASEO_REPO_DIR"
[[ "$(git branch --show-current)" == "$PASEO_BRANCH" ]] || { print -u2 "Paseo must be on $PASEO_BRANCH (not detached)."; exit 1; }
[[ -z "$(git status --porcelain --untracked-files=no)" ]] || { print -u2 "Paseo tracked files or index are dirty."; exit 1; }
[[ "$(git remote get-url origin 2>/dev/null || true)" == "$PASEO_FORK_URL" ]] || { print -u2 "Expected origin -> $PASEO_FORK_URL"; exit 1; }
[[ "$(git remote get-url upstream 2>/dev/null || true)" == "$PASEO_UPSTREAM_URL" ]] || { print -u2 "Expected upstream -> $PASEO_UPSTREAM_URL"; exit 1; }
[[ "$(git config --get branch.$PASEO_BRANCH.remote 2>/dev/null || true)" == origin ]] || { print -u2 "Expected $PASEO_BRANCH to track origin."; exit 1; }
[[ "$(git config --get branch.$PASEO_BRANCH.merge 2>/dev/null || true)" == "refs/heads/$PASEO_BRANCH" ]] || { print -u2 "Unexpected tracking merge ref."; exit 1; }
[[ "$(git remote | LC_ALL=C sort | tr '\n' ' ')" == "origin upstream " ]] || { print -u2 "Unexpected additional or missing Paseo remotes."; exit 1; }
[[ -z "$(git config --get core.hooksPath 2>/dev/null || true)" ]] || { print -u2 "Custom core.hooksPath is not safe for Paseo prepare."; exit 1; }
remote_head=$(git ls-remote "$PASEO_FORK_URL" "refs/heads/$PASEO_BRANCH" | awk 'NR == 1 {print $1}')
[[ "$remote_head" == "$PASEO_VERIFIED_COMMIT" ]] || { print -u2 "Fork branch is not audited commit $PASEO_VERIFIED_COMMIT"; exit 1; }
for hook in .git/hooks/*; do
  [[ -f "$hook" && "$hook" != *.sample ]] || continue
  grep -Eqi lefthook "$hook" || { print -u2 "Custom hook would be overwritten: $hook"; exit 1; }
done
[[ -f package-lock.json ]] || { print -u2 "package-lock.json is missing"; exit 1; }

git fetch --quiet --no-tags "$PASEO_FORK_URL" "$PASEO_VERIFIED_COMMIT"
old_commit=$(git rev-parse HEAD)
if [[ "$old_commit" != "$PASEO_VERIFIED_COMMIT" ]]; then
  git merge-base --is-ancestor "$old_commit" "$PASEO_VERIFIED_COMMIT" || { print -u2 "Checkout is ahead or divergent from audited commit."; exit 1; }
  git update-ref "refs/heads/$PASEO_BRANCH" "$PASEO_VERIFIED_COMMIT" "$old_commit"
  if ! git restore --source="$PASEO_VERIFIED_COMMIT" --staged --worktree -- .; then
    git update-ref "refs/heads/$PASEO_BRANCH" "$old_commit" "$PASEO_VERIFIED_COMMIT"
    git restore --source="$old_commit" --staged --worktree -- .
    print -u2 "Could not materialize audited fast-forward; restored prior commit."
    exit 1
  fi
fi

lock_before=$(shasum -a 256 package-lock.json | awk '{print $1}')
lock_backup=$(mktemp "${TMPDIR:-/tmp}/paseo-lock.XXXXXX")
cp -p package-lock.json "$lock_backup"
if ! "$NPM_BIN" ci; then cp -p "$lock_backup" package-lock.json; rm -f "$lock_backup"; print -u2 "npm ci failed"; exit 1; fi
if [[ "$lock_before" != "$(shasum -a 256 package-lock.json | awk '{print $1}')" ]]; then
  cp -p "$lock_backup" package-lock.json
  rm -f "$lock_backup"
  print -u2 "npm ci changed package-lock.json (restored original)"
  exit 1
fi
rm -f "$lock_backup"

case "$(uname -m)" in
  arm64) arch_flag=--arm64; build_app="$PASEO_REPO_DIR/packages/desktop/release/mac-arm64/Paseo.app" ;;
  x86_64) arch_flag=--x64; build_app="$PASEO_REPO_DIR/packages/desktop/release/mac/Paseo.app" ;;
  *) print -u2 "Unsupported architecture"; exit 1 ;;
esac
print "Building audited Paseo $PASEO_VERIFIED_COMMIT"
CSC_IDENTITY_AUTO_DISCOVERY=false "$NPM_BIN" run build:desktop -- --publish never --mac "$arch_flag" --dir
[[ -d "$build_app" ]] || { print -u2 "Desktop build not found: $build_app"; exit 1; }
codesign --force --deep --sign - "$build_app"
codesign --verify --deep --strict "$build_app"

osascript -e 'tell application id "sh.paseo.desktop" to quit' 2>/dev/null || true
for _ in {1..40}; do
  pgrep -f '/Applications/Paseo.app/Contents/MacOS/Paseo' >/dev/null || break
  sleep 0.25
done
"$PASEO_REPO_DIR/packages/cli/bin/paseo" daemon stop --home "$PASEO_HOME_DIR" >/dev/null 2>&1 || true
if [[ -d "$INSTALLED_APP" ]]; then
  backup_app="${INSTALLED_APP%.app}.previous-$(date +%Y%m%d-%H%M%S).app"
  mv "$INSTALLED_APP" "$backup_app"
  print "Backup: $backup_app"
fi
ditto "$build_app" "$INSTALLED_APP"
ln -sfn "$PASEO_REPO_DIR/packages/cli/bin/paseo" @@HOME@@/.local/bin/paseo
"$PASEO_REPO_DIR/packages/cli/bin/paseo" daemon start --home "$PASEO_HOME_DIR" --listen 127.0.0.1:6767 --relay
open "$INSTALLED_APP"
print "Local Paseo update complete at audited commit $PASEO_VERIFIED_COMMIT."
