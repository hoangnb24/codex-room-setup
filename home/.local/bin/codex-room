#!/usr/bin/env bash
set -euo pipefail

usage="usage: codex-room <supervisor|lead|peer> [codex args...]"

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
sync_bin="${CODEX_ROOM_SYNC_BIN:-${script_dir}/codex-room-sync}"
if [[ -n "${CODEX_ROOM_LAB_ROOT:-}" ]]; then
  runtime_root="${CODEX_ROOM_RUNTIME_ROOT:-${CODEX_ROOM_LAB_ROOT}/.runtime}"
else
  runtime_root="${CODEX_ROOM_RUNTIME_ROOT:-${HOME}/.codex-runtime}"
fi

role="${1:?$usage}"
shift

case "$role" in
  supervisor|lead|peer) ;;
  *) echo "unknown role: $role" >&2; exit 2 ;;
esac

role_home="${runtime_root}/${role}"
[[ ! -L "$role_home" ]] || { echo "runtime role directory must not be a symlink: $role_home" >&2; exit 2; }
"${sync_bin}" "${role}"
[[ ! -L "$role_home" ]] || { echo "runtime role directory became a symlink: $role_home" >&2; exit 2; }
export CODEX_HOME="$role_home"
codex_bin="${CODEX_BIN:-$(command -v codex)}"
exec "${codex_bin}" "$@"
