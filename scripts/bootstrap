#!/usr/bin/env bash
set -euo pipefail
source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/lib/common.sh"

apply=false
for argument in "$@"; do
  case "$argument" in
    --apply) apply=true ;;
    --dry-run) apply=false ;;
    -h|--help) echo "Usage: scripts/bootstrap [--dry-run|--apply]"; exit 0 ;;
    *) die "unknown argument: $argument" ;;
  esac
done

install_bin="${CODEX_ROOM_INSTALL_BIN:-$REPO_ROOT/scripts/install}"
paseo_install_bin="${PASEO_INSTALL_BIN:-$REPO_ROOT/scripts/install-paseo-fork}"
sync_bin="${CODEX_ROOM_SYNC_ALL_BIN:-$REPO_ROOT/scripts/sync-all}"
verify_bin="${CODEX_ROOM_VERIFY_BIN:-$REPO_ROOT/scripts/verify}"

if [[ "$apply" != true ]]; then
  log "PREFLIGHT Paseo exact commit in disposable checkout"
  log "INSTALL   tracked config, Paseo, Supervisor/Lead/Peer runtimes"
  log "DRY_RUN: no changes made; use --apply"
  exit 0
fi

for command_name in codex python3 git jq node npm; do require_command "$command_name"; done

"$paseo_install_bin" --preflight
"$install_bin" --apply
"$paseo_install_bin"
"$sync_bin"
"$verify_bin"
log "BOOTSTRAP_COMPLETE"
