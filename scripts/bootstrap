#!/usr/bin/env bash
set -euo pipefail
source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/lib/common.sh"

apply=false
for argument in "$@"; do
  case "$argument" in --apply) apply=true ;; --dry-run) apply=false ;; -h|--help) echo "Usage: scripts/bootstrap [--dry-run|--apply]"; exit 0 ;; *) die "unknown argument: $argument" ;; esac
done

value_from() { awk -F'"' -v key="$2" '$1 ~ "^" key " = " {print $2; exit}' "$1"; }
ocr_version=$(value_from "$REPO_ROOT/paseo/versions.toml" open_code_review)
harness_source=$(value_from "$REPO_ROOT/better-harness/source.toml" fork)
harness_ref=$(value_from "$REPO_ROOT/better-harness/source.toml" verified_commit)
harness_marketplace=$(value_from "$REPO_ROOT/better-harness/source.toml" marketplace)
harness_plugin=$(value_from "$REPO_ROOT/better-harness/source.toml" plugin)
harness_home="${CODEX_ROOM_RUNTIME_ROOT:-$HOME/.codex-runtime}/harness"
install_bin="${CODEX_ROOM_INSTALL_BIN:-$REPO_ROOT/scripts/install}"
paseo_install_bin="${PASEO_INSTALL_BIN:-$REPO_ROOT/scripts/install-paseo-fork}"
sync_bin="${CODEX_ROOM_SYNC_ALL_BIN:-$REPO_ROOT/scripts/sync-all}"
verify_bin="${CODEX_ROOM_VERIFY_BIN:-$REPO_ROOT/scripts/verify}"
npm_global_bin="${CODEX_ROOM_NPM_BIN:-npm}"
[[ "$harness_ref" =~ ^[0-9a-f]{40}$ ]] || die "invalid Better Harness audited commit"

if [[ "$apply" != true ]]; then
  log "PREFLIGHT Paseo exact commit in disposable checkout"
  log "PREFLIGHT Better Harness $harness_ref in disposable CODEX_HOME"
  log "INSTALL   Open Code Review $ocr_version"
  log "INSTALL   tracked config, Paseo, runtimes, Better Harness"
  log "DRY_RUN: no changes made; use --apply"
  exit 0
fi

for command_name in codex python3 git jq node "$npm_global_bin"; do require_command "$command_name"; done

# Every predictable dependency/provenance failure is resolved before live state.
"$paseo_install_bin" --preflight
preflight_home=$(mktemp -d "${TMPDIR:-/tmp}/better-harness-preflight.XXXXXX")
backup_root=$(mktemp -d "${TMPDIR:-/tmp}/better-harness-backup.XXXXXX")
cleanup() { rm -rf "$preflight_home" "$backup_root"; }
trap cleanup EXIT
CODEX_HOME="$preflight_home" codex plugin marketplace add "$harness_source" --ref "$harness_ref" --json >/dev/null
CODEX_HOME="$preflight_home" codex plugin add "$harness_plugin" --json >/dev/null
preflight_json=$(CODEX_HOME="$preflight_home" codex plugin marketplace list --json)
preflight_root=$(jq -er --arg name "$harness_marketplace" --arg source "$harness_source" '.marketplaces[] | select(.name == $name and .marketplaceSource.sourceType == "git" and .marketplaceSource.source == $source) | .root' <<<"$preflight_json")
[[ "$(git -C "$preflight_root" rev-parse HEAD)" == "$harness_ref" ]] || die "Better Harness disposable marketplace root is not audited commit"
preflight_plugins=$(CODEX_HOME="$preflight_home" codex plugin list --marketplace "$harness_marketplace" --json)
jq -e --arg plugin "$harness_plugin" 'any(.installed[]?; .pluginId == $plugin and .installed == true and .enabled == true)' <<<"$preflight_plugins" >/dev/null || die "Better Harness disposable plugin install is not enabled"

# Snapshot only state owned by plugin registration before any live transition.
had_harness=false
if [[ -d "$harness_home" ]]; then
  had_harness=true
  cp -a "$harness_home" "$backup_root/harness"
fi
live_started=true
rollback() {
  local status=$?
  if [[ "$status" -ne 0 && "${live_started:-false}" == true ]]; then
    rm -rf "$harness_home"
    if [[ "$had_harness" == true ]]; then mkdir -p "$(dirname "$harness_home")"; cp -a "$backup_root/harness" "$harness_home"; fi
    warn "Better Harness transition failed; prior Harness runtime was restored"
  fi
  exit "$status"
}
trap rollback ERR

actual_ocr_version=$(ocr --version 2>/dev/null | sed -n 's/^open-code-review v\([^ ]*\).*/\1/p' || true)
if [[ "$actual_ocr_version" != "$ocr_version" ]]; then "$npm_global_bin" install --global "@alibaba-group/open-code-review@$ocr_version"; fi
"$install_bin" --apply
"$paseo_install_bin"
"$sync_bin"

marketplaces=$(CODEX_HOME="$harness_home" codex plugin marketplace list --json)
installed=$(CODEX_HOME="$harness_home" codex plugin list --json)
if jq -e --arg plugin "$harness_plugin" 'any(.installed[]?; .pluginId == $plugin)' <<<"$installed" >/dev/null; then
  CODEX_HOME="$harness_home" codex plugin remove "$harness_plugin" --json >/dev/null
fi
if jq -e --arg name "$harness_marketplace" 'any(.marketplaces[]?; .name == $name)' <<<"$marketplaces" >/dev/null; then
  CODEX_HOME="$harness_home" codex plugin marketplace remove "$harness_marketplace" --json >/dev/null
fi
CODEX_HOME="$harness_home" codex plugin marketplace add "$harness_source" --ref "$harness_ref" --json >/dev/null
CODEX_HOME="$harness_home" codex plugin add "$harness_plugin" --json >/dev/null
live_json=$(CODEX_HOME="$harness_home" codex plugin marketplace list --json)
live_root=$(jq -er --arg name "$harness_marketplace" --arg source "$harness_source" '.marketplaces[] | select(.name == $name and .marketplaceSource.sourceType == "git" and .marketplaceSource.source == $source) | .root' <<<"$live_json")
[[ "$(git -C "$live_root" rev-parse HEAD)" == "$harness_ref" ]] || die "live Better Harness marketplace root is not audited commit"
"$sync_bin" harness
"$verify_bin"
trap - ERR
live_started=false
log "BOOTSTRAP_COMPLETE"
