VERIFY_SOURCE = ROOT / "scripts" / "verify"
PASEO_SOURCE = ROOT / "scripts" / "install-paseo-fork"
LEGACY_SOURCE_ROOT = ROOT / "paseo" / "legacy"

ROLES = ("supervisor", "lead", "peer")

